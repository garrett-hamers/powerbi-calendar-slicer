{
    "privileges": [],
    "supportsHighlight": false,
    "supportsKeyboardFocus": true,
    "supportsSynchronizingFilterState": true,
    "supportsLandingPage": true,
    "supportsEmptyDataView": true,
    "suppressDefaultTitle": true,
    "dataRoles": [
        {
            "displayName": "Date",
            "displayNameKey": "Role_Date",
            "name": "Date",
            "kind": "Grouping",
            "description": "One concrete Date/DateTime column to filter the report by",
            "descriptionKey": "Role_Date_Desc"
        },
        {
            "displayName": "Values",
            "displayNameKey": "Role_Values",
            "name": "Values",
            "kind": "Measure",
            "description": "Optional measure used to heat-shade days by magnitude",
            "descriptionKey": "Role_Values_Desc"
        },
        {
            "displayName": "Tooltips",
            "displayNameKey": "Role_Tooltips",
            "name": "Tooltips",
            "kind": "GroupingOrMeasure",
            "description": "Optional fields shown in native and report-page tooltips",
            "descriptionKey": "Role_Tooltips_Desc"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "Date": { "min": 1, "max": 1 },
                    "Values": { "min": 0, "max": 1 },
                    "Tooltips": { "min": 0, "max": 10 }
                }
            ],
            "categorical": {
                "categories": {
                    "for": { "in": "Date" },
                    "dataReductionAlgorithm": { "top": { "count": 30000 } }
                },
                "values": {
                    "select": [
                        { "bind": { "to": "Values" } },
                        { "for": { "in": "Tooltips" } }
                    ]
                }
            }
        }
    ],
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        },
        "roles": [
            "Tooltips"
        ],
        "supportEnhancedTooltips": true
    },
    "objects": {
        "general": {
            "properties": {
                "filter": {
                    "type": { "filter": true }
                },
                "visibleYear": {
                    "type": { "numeric": true },
                    "filterState": true
                },
                "visibleMonth": {
                    "type": { "numeric": true },
                    "filterState": true
                },
                "activePreset": {
                    "type": { "text": true },
                    "filterState": true
                }
            }
        },
        "calendar": {
            "properties": {
                "weekStartDay": {
                    "type": {
                        "enumeration": [
                            { "value": "0", "displayName": "Sunday", "displayNameKey": "Calendar_WeekStart_Sunday" },
                            { "value": "1", "displayName": "Monday", "displayNameKey": "Calendar_WeekStart_Monday" },
                            { "value": "6", "displayName": "Saturday", "displayNameKey": "Calendar_WeekStart_Saturday" }
                        ]
                    }
                },
                "monthsToShow": {
                    "type": { "integer": true }
                },
                "showTodayMarker": {
                    "type": { "bool": true }
                },
                "showWeekNumbers": {
                    "type": { "bool": true }
                },
                "fiscalYearStartMonth": {
                    "type": {
                        "enumeration": [
                            { "value": "1", "displayName": "January", "displayNameKey": "Month_January" },
                            { "value": "2", "displayName": "February", "displayNameKey": "Month_February" },
                            { "value": "3", "displayName": "March", "displayNameKey": "Month_March" },
                            { "value": "4", "displayName": "April", "displayNameKey": "Month_April" },
                            { "value": "5", "displayName": "May", "displayNameKey": "Month_May" },
                            { "value": "6", "displayName": "June", "displayNameKey": "Month_June" },
                            { "value": "7", "displayName": "July", "displayNameKey": "Month_July" },
                            { "value": "8", "displayName": "August", "displayNameKey": "Month_August" },
                            { "value": "9", "displayName": "September", "displayNameKey": "Month_September" },
                            { "value": "10", "displayName": "October", "displayNameKey": "Month_October" },
                            { "value": "11", "displayName": "November", "displayNameKey": "Month_November" },
                            { "value": "12", "displayName": "December", "displayNameKey": "Month_December" }
                        ]
                    }
                }
            }
        },
        "cells": {
            "properties": {
                "textColor": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "headerColor": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "selectedColor": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "todayColor": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "weekendShading": {
                    "type": { "bool": true }
                },
                "weekendColor": {
                    "type": { "fill": { "solid": { "color": true } } }
                }
            }
        },
        "heatmap": {
            "properties": {
                "show": {
                    "type": { "bool": true }
                },
                "minColor": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "maxColor": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "datesWithDataOnly": {
                    "type": { "bool": true }
                }
            }
        },
        "presets": {
            "properties": {
                "show": {
                    "type": { "bool": true }
                }
            }
        },
        "interaction": {
            "properties": {
                "multiSelect": {
                    "type": { "bool": true }
                }
            }
        }
    }
}
